models/
wheels/

# data/ contents — selective tracking
experiments/data/*
!experiments/data/cognitive_stimuli/
!experiments/data/brain_maps/

# Cognitive stimuli — track JSONL/CSV/MD/scripts, ignore raw downloads
experiments/data/cognitive_stimuli/**/warriner_raw.csv
experiments/data/cognitive_stimuli/**/goemotions_*.tsv
experiments/data/cognitive_stimuli/**/goemotions_*.txt
experiments/data/cognitive_stimuli/**/goemotions_*.json
experiments/data/cognitive_stimuli/**/__pycache__/

# Brain maps — track manifests/docs only (raw map files too large for git)
experiments/data/brain_maps/**/*.nii.gz
experiments/data/brain_maps/**/*.img
experiments/data/brain_maps/**/*.hdr
experiments/data/brain_maps/**/raw/
experiments/data/brain_maps/**/__pycache__/

# SLURM logs (transient; results captured in results/*.json)
experiments/logs/

# Python artifacts
**/__pycache__/
*.pyc

# Large activation/attribution data dumps — sync code, not data (regenerable on GPU)
experiments/results/**/*_rsa_v2_per_stim.npz
experiments/results/**/*_rsa_activations.npz
experiments/results/**/*_multi_attribution.npz
experiments/results/**/*_contrast_attribution.npz
experiments/results/narratives_llm/*.npz
experiments/results/cognitive_rsa/regional_xarch_brain_cache.npz
experiments/results/cognitive_rsa/narratives_group_patterns.npz
